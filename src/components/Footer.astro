---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container sf-inner">
    <p class="sf-copy">&copy; {year} Dakota Oberhauser. All rights reserved.</p>
    <nav class="sf-nav" aria-label="Footer navigation">
      <a href="/personal-site/"     class="sf-link">Portfolio</a>
      <a href="/personal-site/blog" class="sf-link">Writing</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
  }

  .sf-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .sf-copy {
    font-size: 0.875rem;
    color: var(--ink3);
    margin: 0;
  }

  .sf-nav {
    display: flex;
    gap: 1.5rem;
  }

  .sf-link {
    font-size: 0.875rem;
    color: var(--ink2);
    text-decoration: none;
    transition: color 220ms ease;
  }
  .sf-link:hover {
    color: var(--blue);
  }

  @media (max-width: 480px) {
    .sf-inner {
      flex-direction: column;
      text-align: center;
    }
    .sf-nav {
      justify-content: center;
    }
  }
</style>
