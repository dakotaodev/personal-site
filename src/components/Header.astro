---
// Shared nav for blog / about pages.
// The portfolio (index.astro) has its own inline nav.
---

<header class="site-nav" id="siteNav">
  <div class="container sn-inner">
    <a href="/personal-site/" class="sn-brand">Dakota Oberhauser</a>

    <nav class="sn-links" aria-label="Site navigation">
      <a href="/personal-site/"    class="sn-link">Portfolio</a>
      <a href="/personal-site/blog" class="sn-link">Writing</a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 64px;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 220ms ease, box-shadow 220ms ease;
  }

  .site-nav.scrolled {
    border-bottom-color: var(--border);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
  }

  .sn-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .sn-brand {
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    transition: color 220ms ease;
  }
  .sn-brand:hover {
    color: var(--blue);
    text-decoration: none;
  }

  .sn-links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .sn-link {
    padding: 0.375rem 0.7rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink2);
    border-radius: var(--r);
    text-decoration: none;
    transition: color 220ms ease, background 220ms ease;
  }
  .sn-link:hover {
    color: var(--ink);
    background: var(--surface);
    text-decoration: none;
  }
</style>

<script>
  const nav = document.getElementById('siteNav');
  if (nav) {
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
