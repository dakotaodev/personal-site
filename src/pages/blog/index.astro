---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Writing — Dakota Oberhauser"
      description="Explorations, project notes, and things worth sharing."
    />
  </head>

  <body>
    <Header />

    <main class="blog-main">
      <div class="container">

        <header class="page-hd">
          <h1 class="page-title">Writing</h1>
          <p class="page-sub">
            Explorations, project notes, and things worth sharing.
          </p>
        </header>

        {
          posts.length > 0 ? (
            <div class="post-list">
              {posts.map((post) => (
                <a
                  href={`/personal-site/blog/${post.id}/`}
                  class="post-item"
                >
                  <div class="post-item-row">
                    <h2 class="post-title">{post.data.title}</h2>
                    <time
                      class="post-date"
                      datetime={post.data.pubDate.toISOString()}
                    >
                      {post.data.pubDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                    </time>
                  </div>
                  <p class="post-desc">{post.data.description}</p>
                </a>
              ))}
            </div>
          ) : (
            <p class="no-posts">No posts yet — check back soon.</p>
          )
        }

      </div>
    </main>

    <Footer />
  </body>
</html>

<style>
  .blog-main {
    padding: 4rem 0 6rem;
    min-height: calc(100svh - 64px - 73px); /* nav + footer */
  }

  /* Page header */
  .page-hd {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .page-sub {
    font-size: 1.0625rem;
    color: var(--ink2);
    margin: 0;
  }

  /* Post list */
  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-item {
    display: block;
    padding: 1.625rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }
  .post-item:last-child { border-bottom: none; }
  .post-item:hover .post-title { color: var(--blue); }

  .post-item-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .post-title {
    font-size: 1.1875rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0;
    letter-spacing: -0.01em;
    transition: color 220ms ease;
  }

  .post-date {
    font-size: 0.875rem;
    color: var(--ink3);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .post-desc {
    font-size: 0.9375rem;
    color: var(--ink2);
    line-height: 1.6;
    margin: 0;
  }

  .no-posts {
    color: var(--ink3);
    font-size: 1rem;
    margin: 0;
  }
</style>
